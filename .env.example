# OAuth2 app credentials from https://www.openstreetmap.org/oauth2/applications
# Register a new confidential application with scopes: read_prefs, write_api
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=

# Must match the redirect URI configured in the OSM OAuth2 app settings
OSM_REDIRECT_URI=https://localhost:8000/auth/callback

# Secret key for signing session cookies — generate with: openssl rand -hex 32
SESSION_SECRET=
